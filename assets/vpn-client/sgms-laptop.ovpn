# vpn-client (R4.8/R4.12): структура .ovpn-профиля — публичные данные
# провайдера (SEC-2, класс C), не секрет. Заполни значениями своего
# провайдера. Логин/пароль сюда НЕ добавлять: они отдельно в sops
# (ключ vpnClient.credentials), строку auth-user-pass достраивает сам
# NixOS-модуль (services.openvpn.servers.corporate.authUserPass).
client
dev tun
proto <udp-или-tcp>
remote <SERVER_HOST> <PORT>
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
cipher <CIPHER>
verb 3
# Если провайдер требует сертификаты — ca/cert/key или инлайн-блоки
# <ca>...</ca> дописать сюда.
