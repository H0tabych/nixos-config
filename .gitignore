# --- добавить в .gitignore (STRUCTURE.md, раздел 2) ---
result
result-*
.direnv/
.env
.env.*

# шаблоны проектов (R6.2): локальные сборочные артефакты, не часть шаблона
/templates/*/.venv/
/templates/*/target/
/templates/*/build/

# личные настройки ассистента
CLAUDE.local.md
.claude/settings.local.json

# приватные материалы и ключи (хранятся вне репозитория, это страховка)
/docs/private/
keys.txt
*.age
*.key

.aider*
