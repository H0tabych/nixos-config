# Фича: net-facts · Слот: — · Домен: network · Классы: N · Для: всех хостов
# Контракт: ARCH-4, ARCH-5, VPN-INT-3, ADR-43. Объявляет схему my.net.* — факты о
# сетевой политике хоста, которые заполняют не владельцы туннеля, а сами службы
# (аналог host-facts): без значений, без логики и без пакетов.
#
# Зачем отдельно от my.tunnel.*. Службе, которой нужен прямой путь (торрент-демон),
# надо сообщить об этом политике туннеля, а фича media живёт и на хосте без tunnel
# (опции my.tunnel.* там нет). Определить необъявленную опцию условно нельзя: под
# mkIf false она всё равно остаётся определением, а проверка наличия в самом
# определении даёт бесконечную рекурсию. Поэтому факт объявлен там, где он есть всегда
# (пресет base), а читает его реализация слота tunnel — только если она есть.
# Зависимости: —
_: {
  flake.modules.nixos.net-facts =
    { lib, ... }:
    {
      options.my.net.bypass.users = lib.mkOption {
        type = lib.types.listOf lib.types.str;
        default = [ ];
        example = [ "transmission" ];
        description = ''
          Системные пользователи, чей исходящий трафик идёт мимо туннеля (VPN-INT-3, MAY).
          Признак — числовой uid (у каждого должен быть явный users.users.<имя>.uid):
          nftables разрешает путь cgroup при загрузке правил, когда юнита ещё нет, а у
          перезапущенного юнита id каталога новый (ADR-43). Поэтому клиент обхода — служба
          со своим пользователем, а не процесс пользовательской сессии. DNS и DoT таких
          пользователей в обход не идут (VPN-KS-5). Заполняют фичи-владельцы служб.
        '';
      };
    };
}
